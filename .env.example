# Select one database: mysql OR mongodb
DATABASE_TYPE=mysql
PORT=3000

# MySQL settings (used when DATABASE_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=foodshare

# MongoDB settings (used when DATABASE_TYPE=mongodb)
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/foodshare
# For MongoDB Atlas, replace the URI with your Atlas connection string.
